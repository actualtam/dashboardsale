datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  OWNER
  ADMIN
  ACCOUNTANT
  BRANCH_MANAGER
  INVENTORY_MANAGER
  CASHIER
  SALESPERSON
  AUDITOR
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum OnlineOrderStatus {
  NEW
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  fullName     String
  passwordHash String
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  BusinessMembership[]
  auditLogs    AuditLog[]
  shifts       CashShift[]
  sales        Sale[]
}

model Business {
  id           String   @id @default(uuid())
  name         String
  legalName    String?
  taxId        String?  // INN
  currency     String   @default("UZS")
  timezone     String   @default("Asia/Tashkent")
  logoUrl      String?
  phone        String?
  email        String?
  address      String?
  taxRate      Decimal  @default(12.0) @db.Decimal(5, 2) // QQS
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       BusinessMembership[]
  branches          Branch[]
  warehouses        Warehouse[]
  cashRegisters     CashRegister[]
  categories        Category[]
  brands            Brand[]
  suppliers         Supplier[]
  products          Product[]
  customers         Customer[]
  promotions        Promotion[]
  sales             Sale[]
  purchaseOrders    PurchaseOrder[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  onlineOrders      OnlineOrder[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  integrations      IntegrationSetting[]
  transfers         StockTransfer[]
  stockCounts       StockCount[]
  giftCertificates  GiftCertificate[]
}

model BusinessMembership {
  id              String   @id @default(uuid())
  businessId      String
  userId          String
  role            RoleType @default(CASHIER)
  defaultBranchId String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBranch   Branch?  @relation(fields: [defaultBranchId], references: [id])

  @@unique([businessId, userId])
}

model Branch {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String
  address     String?
  phone       String?
  managerName String?
  isMain      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses    Warehouse[]
  cashRegisters CashRegister[]
  sales         Sale[]
  expenses      Expense[]
  shifts        CashShift[]
  memberships   BusinessMembership[]
  sourceTransfers StockTransfer[] @relation("SourceBranch")
  destTransfers   StockTransfer[] @relation("DestBranch")
  stockCounts   StockCount[]
  onlineOrders  OnlineOrder[]

  @@unique([businessId, code])
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String
  branchId   String
  name       String
  code       String
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  balances          InventoryBalance[]
  movements         InventoryMovement[]
  sourceTransfers   StockTransfer[]     @relation("SourceWarehouse")
  destTransfers     StockTransfer[]     @relation("DestWarehouse")
  stockCounts       StockCount[]
  purchaseOrders    PurchaseOrder[]

  @@unique([businessId, code])
}

model CashRegister {
  id         String   @id @default(uuid())
  businessId String
  branchId   String
  name       String
  code       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts     CashShift[]
  sales      Sale[]

  @@unique([branchId, code])
}

model CashShift {
  id              String      @id @default(uuid())
  businessId      String
  branchId        String
  cashRegisterId  String
  cashierId       String
  openingCash     Decimal     @default(0) @db.Decimal(12, 2)
  closingCash     Decimal?    @db.Decimal(12, 2)
  expectedCash    Decimal?    @db.Decimal(12, 2)
  cashDifference  Decimal?    @db.Decimal(12, 2)
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  notes           String?

  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  cashier         User         @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  movements       CashMovement[]
  sales           Sale[]
}

model CashMovement {
  id        String   @id @default(uuid())
  shiftId   String
  type      String   // IN, OUT
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  createdAt DateTime @default(now())

  shift     CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model Category {
  id         String   @id @default(uuid())
  businessId String
  name       String
  code       String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryParent")
  products   Product[]

  @@unique([businessId, code])
}

model Brand {
  id         String    @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
}

model Supplier {
  id            String   @id @default(uuid())
  businessId    String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  taxId         String?  // INN
  address       String?
  notes         String?
  currentBalance Decimal @default(0) @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  categoryId  String
  brandId     String?
  supplierId  String?
  name        String
  description String?
  unit        String   @default("pcs")
  taxRate     Decimal  @default(12.0) @db.Decimal(5, 2)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  variants    ProductVariant[]
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  barcode       String?  @unique
  size          String?
  color         String?
  costPrice     Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  minStockAlert Int      @default(5)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseOrderItem[]
  transferItems    StockTransferItem[]
  stockCountItems  StockCountItem[]
  onlineOrderItems OnlineOrderItem[]
  refundItems      RefundItem[]
}

model InventoryBalance {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String
  warehouseId      String
  variantId        String
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  lastUpdated      DateTime @default(now())

  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([businessId, branchId])
}

model InventoryMovement {
  id            String   @id @default(uuid())
  businessId    String
  branchId      String
  warehouseId   String
  variantId     String
  movementType  String   // SALE, RETURN, PURCHASE_RECEIPT, TRANSFER_DISPATCH, TRANSFER_RECEIVE, ADJUSTMENT, WRITE_OFF
  quantity      Int      // positive for increase, negative for decrease
  costBasis     Decimal  @db.Decimal(12, 2)
  referenceType String?  // Sale, PurchaseOrder, StockTransfer, StockCount
  referenceId   String?
  reason        String?
  actorId       String?
  createdAt     DateTime @default(now())

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId, branchId, warehouseId])
  @@index([variantId])
  @@index([createdAt])
}

model StockTransfer {
  id                   String         @id @default(uuid())
  businessId           String
  sourceBranchId       String
  sourceWarehouseId    String
  destBranchId         String
  destWarehouseId      String
  transferNumber       String         @unique
  status               TransferStatus @default(DRAFT)
  dispatchedAt         DateTime?
  receivedAt           DateTime?
  createdById          String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceBranch         Branch            @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  destBranch           Branch            @relation("DestBranch", fields: [destBranchId], references: [id])
  sourceWarehouse      Warehouse         @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse        Warehouse         @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  items                StockTransferItem[]
}

model StockTransferItem {
  id               String   @id @default(uuid())
  transferId       String
  variantId        String
  quantitySent     Int
  quantityReceived Int      @default(0)

  transfer         StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model StockCount {
  id            String           @id @default(uuid())
  businessId    String
  branchId      String
  warehouseId   String
  countNumber   String           @unique
  status        StockCountStatus @default(DRAFT)
  conductedById String?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch           @relation(fields: [branchId], references: [id])
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  items         StockCountItem[]
}

model StockCountItem {
  id                  String   @id @default(uuid())
  stockCountId        String
  variantId           String
  systemQuantity      Int
  countedQuantity     Int
  discrepancyQuantity Int
  costDifference      Decimal  @db.Decimal(12, 2)

  stockCount          StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Customer {
  id                   String   @id @default(uuid())
  businessId           String
  fullName             String
  phone                String
  email                String?
  address              String?
  segment              String   @default("REGULAR") // REGULAR, VIP, NEW, INACTIVE
  notes                String?
  currentLoyaltyPoints Int      @default(0)
  totalSpend           Decimal  @default(0) @db.Decimal(12, 2)
  totalOrders          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales                Sale[]
  loyaltyTransactions  LoyaltyTransaction[]
  onlineOrders         OnlineOrder[]

  @@unique([businessId, phone])
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  customerId String
  type       String   // EARN, BURN, ADJUST
  points     Int
  saleId     String?
  notes      String?
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Promotion {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  type        String   // PERCENTAGE, FIXED, MIN_SPEND
  value       Decimal  @db.Decimal(12, 2)
  minSpend    Decimal? @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)
  promoCode   String?
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  active      Boolean  @default(true)
  usageLimit  Int?
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model GiftCertificate {
  id             String    @id @default(uuid())
  businessId     String
  code           String    @unique
  initialBalance Decimal   @db.Decimal(12, 2)
  currentBalance Decimal   @db.Decimal(12, 2)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Sale {
  id             String     @id @default(uuid())
  businessId     String
  branchId       String
  cashRegisterId String
  cashierId      String
  customerId     String?
  shiftId        String?
  saleNumber     String     @unique
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountTotal  Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)
  costTotal      Decimal    @default(0) @db.Decimal(12, 2)
  grossProfit    Decimal    @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id])
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  cashier        User          @relation(fields: [cashierId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  shift          CashShift?    @relation(fields: [shiftId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  refunds        Refund[]

  @@index([businessId, branchId, createdAt])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  variantId      String
  quantity       Int
  unitCost       Decimal  @db.Decimal(12, 2)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)

  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  refundItems    RefundItem[]
}

model Payment {
  id             String   @id @default(uuid())
  saleId         String
  method         String   // CASH, UZCARD, HUMO, PAYME, CLICK, STORE_CREDIT
  amount         Decimal  @db.Decimal(12, 2)
  transactionRef String?
  status         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Refund {
  id                String       @id @default(uuid())
  saleId            String
  businessId        String
  branchId          String
  cashierId         String
  refundNumber      String       @unique
  totalRefundAmount Decimal      @db.Decimal(12, 2)
  reason            String?
  createdAt         DateTime     @default(now())

  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items             RefundItem[]
}

model RefundItem {
  id           String   @id @default(uuid())
  refundId     String
  saleItemId   String
  variantId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  refundAmount Decimal  @db.Decimal(12, 2)
  restocked    Boolean  @default(true)
  condition    String   @default("GOOD") // GOOD, DAMAGED

  refund       Refund         @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem     SaleItem       @relation(fields: [saleItemId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
}

model SuspendedSale {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String
  cashierId    String
  customerId   String?
  cartDataJson String   @db.Text
  note         String?
  createdAt    DateTime @default(now())
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  businessId   String
  branchId     String
  warehouseId  String
  supplierId   String
  orderNumber  String              @unique
  status       PurchaseOrderStatus @default(DRAFT)
  subtotal     Decimal             @db.Decimal(12, 2)
  taxTotal     Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal             @db.Decimal(12, 2)
  createdById  String?
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal  @db.Decimal(12, 2)
  totalCost        Decimal  @db.Decimal(12, 2)

  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id])
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([businessId, code])
}

model Expense {
  id            String   @id @default(uuid())
  businessId    String
  branchId      String
  categoryId    String
  createdById   String?
  amount        Decimal  @db.Decimal(12, 2)
  description   String
  paymentMethod String   @default("CASH") // CASH, BANK_TRANSFER
  status        String   @default("APPROVED") // PENDING, APPROVED
  expenseDate   DateTime @default(now())
  createdAt     DateTime @default(now())

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id])
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([businessId, branchId, expenseDate])
}

model OnlineOrder {
  id              String            @id @default(uuid())
  businessId      String
  branchId        String
  customerId      String?
  orderNumber     String            @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryMethod  String            @default("PICKUP") // PICKUP, DELIVERY
  deliveryAddress String?
  status          OnlineOrderStatus @default(NEW)
  paymentMethod   String            @default("CASH") // CASH, PAYME, CLICK
  paymentStatus   String            @default("PENDING") // PENDING, PAID, FAILED
  subtotal        Decimal           @db.Decimal(12, 2)
  deliveryFee     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal           @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  items           OnlineOrderItem[]
}

model OnlineOrderItem {
  id            String   @id @default(uuid())
  onlineOrderId String
  variantId     String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)

  onlineOrder   OnlineOrder    @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  title      String
  message    String
  type       String   @default("SYSTEM") // LOW_STOCK, SHIFT_ALERT, ORDER_NEW, EXPENSE_APPROVAL, SYSTEM
  read       Boolean  @default(false)
  link       String?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String?
  action        String
  entityName    String
  entityId      String?
  oldValuesJson String?  @db.Text
  newValuesJson String?  @db.Text
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
}

model IntegrationSetting {
  id         String   @id @default(uuid())
  businessId String
  provider   String   // PAYME, CLICK, TELEGRAM, ONEC
  enabled    Boolean  @default(false)
  configJson String   @default("{}") @db.Text
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum EquipmentOrderStatus {
  NEW
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model HardwareCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  nameUz      String
  nameRu      String?
  description String?  @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    HardwareProduct[]
}

model HardwareProduct {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameUz         String
  nameRu         String?
  categorySlug   String
  sku            String   @unique
  price          Decimal? @db.Decimal(12, 2)
  currency       String   @default("UZS")
  priceOnRequest Boolean  @default(false)
  descriptionUz  String   @db.Text
  descriptionRu  String?  @db.Text
  imagesJson     String   @default("[]") @db.Text
  specsJson      String   @default("{}") @db.Text
  compatJson     String   @default("[]") @db.Text
  inStock        Boolean  @default(true)
  isPublished    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       HardwareCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)

  @@index([categorySlug, isPublished])
}

model ServiceInquiry {
  id               String        @id @default(uuid())
  inquiryNumber    String        @unique
  serviceKey       String
  customerName     String
  phone            String
  businessName     String?
  message          String?       @db.Text
  preferredContact String        @default("TELEGRAM")
  status           InquiryStatus @default(NEW)
  ipAddress        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
}

model EquipmentOrder {
  id             String               @id @default(uuid())
  orderNumber    String               @unique
  customerName   String
  phone          String
  deliveryMethod String               @default("COURIER")
  address        String?              @db.Text
  notes          String?              @db.Text
  itemsJson      String               @db.Text
  totalAmount    Decimal              @db.Decimal(14, 2)
  status         EquipmentOrderStatus @default(NEW)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
}
